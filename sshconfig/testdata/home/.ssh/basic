# Basic syntax: keywords are case-insensitive, values may follow whitespace or '='.

Host web
    HostName web01.example.com
    Port 2222
    User alice

Host db
    hostname=db01.example.com
    PORT = 2200
    user  bob   # trailing comment

Host "build server" ci
    HostName "ci.example.com"
    IdentityFile "~/.ssh/ci key"

Host web
    # Already set above: the first value wins.
    Port 9999
