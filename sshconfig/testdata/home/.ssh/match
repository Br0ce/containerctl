# Match blocks: host checks the hostname after HostName, originalhost checks the alias.

Host app
    HostName app.prod.example.com

Match host *.prod.example.com
    User prod

Match originalhost app
    Port 2300

Match exec "test -n \"$CI\"" host *.example.com
    # exec is not supported: the block never matches.
    IdentityFile ~/.ssh/ci_key

Match user root
    Port 1

Match !host *.prod.example.com originalhost staging-*
    HostName %h.staging.example.com

Match all
    User fallback
    Port 22
