# Token and tilde expansion per keyword, see TOKENS in ssh_config(5).

Host web
    HostName %h.example.com
    User %u-admin
    Port 2222
    ProxyJump bastion.example.com
    IdentityFile ~/.ssh/%h_%r
    IdentityFile %d/keys/%n-%i
    ControlPath ~/.ssh/cm-%C
    ProxyCommand ssh -W %h:%p %r@gateway
    UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts2
    RemoteCommand echo %L %l %k 100%%
    # SendEnv takes no tokens: the value is returned as written.
    SendEnv LC_%h

Host plain
    # Defaults: %h is the alias, %p 22, %r the local user, %j empty.
    IdentityFile ~/.ssh/%h-%p-%r-%j
    HostKeyAlias plain-key
    RemoteCommand echo %k

Host bad-hostname
    HostName %u.example.com

Host bad-proxy
    ProxyCommand nc %d %p

Host bad-user
    User %r

Host conn-only
    # %T is only known while connecting.
    LocalCommand echo %T

Host bad-nested
    HostName %x
    IdentityFile ~/.ssh/%h

Host bad-trailing
    IdentityFile ~/.ssh/id%
