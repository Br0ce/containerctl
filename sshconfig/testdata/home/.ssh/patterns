# Wildcards, negation, %h in HostName and first-value-wins with a catch-all at the end.

Host prod-* !prod-legacy
    HostName %h.corp.example.com
    User ops
    IdentityFile ~/.ssh/%h_ed25519

Host prod-legacy
    HostName legacy.example.com

Host lab?
    HostName %h.lab.example.com
    Port 2022

Host *.internal
    ProxyJump bastion.example.com

Host *
    User default
    Port 22
    IdentityFile ~/.ssh/id_ed25519
